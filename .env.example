# Copy this file to .env and fill in your own values. Never commit .env.
# Local Ganache (desktop app default shown; Ganache CLI usually uses port 8545)
WEB3_PROVIDER_URI=http://127.0.0.1:7545
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
PRIVATE_KEY=0xPRIVATE_KEY_OF_A_GANACHE_TEST_ACCOUNT
CHAIN_ID=1337

# To use the public Sepolia testnet instead:
# WEB3_PROVIDER_URI=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# CHAIN_ID=11155111
